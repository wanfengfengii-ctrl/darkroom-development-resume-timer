{
  "name": "darkroom-timer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "暗房冲洗续时台：可跨刷新/息屏续时的三阶段纯前端计时器",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
